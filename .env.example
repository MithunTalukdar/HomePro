# Frontend Variables
VITE_API_URL=http://localhost:5000

# Backend Variables
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/homepro
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/homepro
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=30d
NODE_ENV=development

# Frontend URL for CORS and password reset links (no trailing slash)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Email SMTP (backend) - required for Forgot/Reset Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ServeSync <noreply@servesync.com>

# Vercel
VERCEL=0
