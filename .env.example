# Frontend Variables
VITE_API_URL=http://localhost:5000

# Backend Variables
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/test
JWT_SECRET=your_jwt_secret_key
NODE_ENV=development

# Password Reset - Frontend URL used by backend to generate reset links
FRONTEND_URL=http://localhost:5173

# Email SMTP (backend) - configure in backend/.env
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=ServeSync <noreply@servesync.com>
