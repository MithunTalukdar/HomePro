# Frontend Environment Variables
# For local development - backend URL (must include protocol, no trailing slash)
VITE_API_URL=http://localhost:5000

# For production (Vercel) - set to deployed backend URL
# Example: VITE_API_URL=https://your-backend.vercel.app
# For same-domain monolith deployment, leave empty to use relative /api
# VITE_API_URL=
