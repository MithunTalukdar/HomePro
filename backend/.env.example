PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/homepro
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Frontend URL for password reset links (no trailing slash)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Email SMTP Configuration (required for Forgot/Reset Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ServeSync <noreply@servesync.com>

# Alternative variable names (supported: EMAIL_HOST/EMAIL_PORT/EMAIL_USER/EMAIL_PASS/EMAIL_FROM)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=ServeSync <noreply@servesync.com>
